#!/bin/sh
# S11diag v5 — BEACON SOSTENIDO con hcdaemon y S99app DESACTIVADOS (nadie redibuja la pantalla).
# Si el usuario ve el patrón (blanco/negro/rojo sostenido), el kernel llegó a rcS y controla fb.
C=/dev/console
say(){ echo "$@" > "$C" 2>&1; }

say "S11DIAG V5: userspace ALIVE. Patron de prueba en pantalla."

# llenar fb0 con patrones alternos sostenidos (no debe ser sobrescrito: hcdaemon/S99 off)
FBSZ=4194304
fill(){ head -c "$FBSZ" /dev/zero | tr '\000' "$1" > /dev/fb0 2>/dev/null; }

# ciclo: blanco 3s, negro 3s, repetir 6 ciclos (~36s) - bien visible
i=0
while [ $i -lt 6 ]; do
  fill '\377'; sleep 3   # blanco (max)
  fill '\000'; sleep 3   # negro
  i=$((i+1))
done
# final: patrón de resultado
say "MMC_DETECT=?"
MMC=""
for d in /dev/mmcblk*; do [ -e "$d" ] && MMC="$MMC $d"; done
if [ -n "$MMC" ]; then
  say "MMC_DETECT=YES DEV=[$MMC]"
  # relleno 'verde' -> pattern 0xFF00FF00 (intento) -> usamos \372 (cuasi-blanco) y luego patron
  fill '\200'; sleep 2
else
  say "MMC_DETECT=NO (sin mmcblk)"
  fill '\150'; sleep 2   # gris medio
fi

# intentar montar + capturar dmesg
TMPLOG=/tmp/dmesg_boot.log
{ echo "===== S11diag v5 $(date) ====="
  echo "cmdline: $(cat /proc/cmdline 2>/dev/null)"
  echo "--- mmcblk ---"; ls -la /dev/mmcblk* 2>/dev/null
  echo "--- mmc_host ---"; ls -la /sys/class/mmc_host/ 2>/dev/null
  echo "--- DMESG mmc/dw/clk ---"; dmesg 2>/dev/null | grep -iE 'mmc|dw|mshc|sdio|clk|hichip|error|fail'
  echo "--- DMESG FULL ---"; dmesg 2>/dev/null
} > "$TMPLOG" 2>&1
say "LOG=/tmp/dmesg_boot.log $(stat -c%s "$TMPLOG" 2>/dev/null)B"

mkdir -p /tmp/sd
for dev in /dev/mmcblk0p1 /dev/mmcblk1p1; do
  if [ -e "$dev" ]; then
    if mount -t vfat "$dev" /tmp/sd 2>/dev/null; then
      cp "$TMPLOG" /tmp/sd/cubegm/dmesg_boot.log 2>/dev/null
      cp "$TMPLOG" /tmp/sd/dmesg_boot_root.log 2>/dev/null
      say "MNT_OK + COPIADO a SD"
      break
    fi
  fi
done

# HOLD: quedarse llenando con parpadeo indefinidamente para que el usuario lo vea
say "REPORTAME: viste el parpadeo blanco/negro repetido?"
while true; do fill '\377'; sleep 2; fill '\000'; sleep 2; done