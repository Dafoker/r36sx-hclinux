#!/bin/sh
# S11diag v4 — BEACON DE COLOR en el framebuffer para confirmar que el kernel llega a userspace.
# Si el usuario ve parpadeo NEGRO-BLANCO-NEGRO, el kernel llegó a rcS (S11diag corrió).
# Si solo ve el logo TreeFrogUI -> azul (sin parpadeo), el kernel se cuelga en init de
# dispositivos (antes de userspace). Independiente de SD y de la visibilidad del texto.
C=/dev/console
say(){ echo "$@" > "$C" 2>&1; }

say "S11DIAG V4 BEACON: si ves parpadeo N/B/N, userspace OK"
# beacon: rellenar fb0 a negro
dd if=/dev/zero of=/dev/fb0 bs=1024 count=4096 2>/dev/null
sleep 2
# blanco (relleno de 0xFF) — intenta varios patrones para que se vea
head -c 4194304 /dev/zero | tr '\000' '\377' > /dev/fb0 2>/dev/null
sleep 2
# negro otra vez
dd if=/dev/zero of=/dev/fb0 bs=1024 count=4096 2>/dev/null
sleep 2
say "BEACON DONE — estoy en userspace (rcS/S11diag v4 corrió)"

MMC=""
for d in /dev/mmcblk*; do [ -e "$d" ] && MMC="$MMC $d"; done
say "MMC_DETECT=$([ -n "$MMC" ] && echo YES || echo NO) DEV=[$MMC]"
say "MMC_HOST=[$(ls /sys/class/mmc_host/ 2>/dev/null)]"

MNT_OK=NO
mkdir -p /tmp/sd
for dev in /dev/mmcblk0p1 /dev/mmcblk1p1; do
  if [ -e "$dev" ]; then
    if mount -t vfat "$dev" /tmp/sd 2>/dev/null; then MNT_OK=YES; say "MNT_OK=YES dev=$dev"; break; fi
  fi
done
[ "$MNT_OK" = YES ] && say "MNT_CUBEGM=$([ -d /tmp/sd/cubegm ] && echo YES || echo NO)"

TMPLOG=/tmp/dmesg_boot.log
{ echo "===== S11diag v4 capture $(date) ====="
  echo "cmdline: $(cat /proc/cmdline 2>/dev/null)"
  echo "--- /dev/mmcblk* ---"; ls -la /dev/mmcblk* 2>/dev/null
  echo "--- /sys/class/mmc_host ---"; ls -la /sys/class/mmc_host/ 2>/dev/null
  echo "--- mmc sysfs ---"; cat /sys/block/mmcblk0/size /sys/block/mmcblk0/device/type 2>/dev/null
  echo "--- DMESG (mmc/dw/clk) ---"; dmesg 2>/dev/null | grep -iE 'mmc|dw|mshc|sdio|clk|hichip|error|fail'
  echo "--- DMESG FULL ---"; dmesg 2>/dev/null
} > "$TMPLOG" 2>&1
say "LOG=/tmp/dmesg_boot.log $(stat -c%s "$TMPLOG" 2>/dev/null)B"
if [ "$MNT_OK" = YES ]; then
  cp "$TMPLOG" /tmp/sd/cubegm/dmesg_boot.log 2>/dev/null && say "COPIADO a SD"
  cp "$TMPLOG" /tmp/sd/dmesg_boot_root.log 2>/dev/null
fi
say "REPORTAME: parpadeo N/B/N? (si/no) y MMC_DETECT=..."
sleep 45
exit 0