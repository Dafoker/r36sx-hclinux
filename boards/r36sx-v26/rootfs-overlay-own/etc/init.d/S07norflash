#!/bin/sh
# S07norflash (Fase D-2c recovery) — auto-flash CIEGO del NOR en boot.
# Diseñado para funcionar SIN PANTALLA: si en la SD existe
#   cubegm/norjob.bin  +  cubegm/norjob.sha256
# → sha-check → mtdnor /dev/mtd1 → borrar job → REBOOT.
# Sin job = cero overhead (espera el montaje, chequea una vez, sale).
# mtdnor se busca en la raiz de la SD (/media/<dev>/mtdnor).
LOG=/tmp/norflash.log
echo "S07norflash: uptime=$(cut -d' ' -f1 /proc/uptime)" > "$LOG"

# 1) esperar el montaje de la SD (max 60s)
N=0; FOUND=""
while [ $N -lt 60 ]; do
  for d in /media/*/cubegm; do [ -d "$d" ] && FOUND="$d"; done
  [ -n "$FOUND" ] && break
  N=$((N+1)); sleep 1
done
[ -z "$FOUND" ] && exit 0

# 2) sin job → boot normal, salir YA (cero overhead)
[ -f "$FOUND/norjob.bin" ] || exit 0

# 3) log del job a la SD
cp "$LOG" "$FOUND/norflash.log" 2>/dev/null; sync

# 4) sha del job (hash COMPLETO de 64)
if [ -f "$FOUND/norjob.sha256" ]; then
  EXP=$(cat "$FOUND/norjob.sha256")
  echo "$EXP  $FOUND/norjob.bin" | sha256sum -c - >> "$LOG" 2>&1 || {
    echo "SHA NO COINCIDE — job ignorado y eliminado" >> "$LOG"
    rm -f "$FOUND/norjob.bin" "$FOUND/norjob.sha256"
    cp "$LOG" "$FOUND/norflash.log" 2>/dev/null; sync; exit 0
  }
fi

# 5) localizar mtdnor (raiz de la SD)
MTD=""
for r in /media/*/mtdnor; do [ -x "$r" ] && MTD="$r" && break; done
[ -z "$MTD" ] && { echo "mtdnor no hallido en la SD — abort" >> "$LOG"; cp "$LOG" "$FOUND/norflash.log"; sync; exit 0; }

# 6) FLASH
echo "flasheando con $MTD ..." >> "$LOG"
"$MTD" /dev/mtd1 "$FOUND/norjob.bin" >> "$LOG" 2>&1
RC=$?
if [ $RC -eq 0 ]; then
  echo "FLASH OK — borrando job y REBOOT (la pantalla volvera con el bootloader de fabrica)" >> "$LOG"
  rm -f "$FOUND/norjob.bin" "$FOUND/norjob.sha256"
  cp "$LOG" "$FOUND/norflash.log" 2>/dev/null
  sync
  reboot
  exit 0
else
  echo "FLASH FAIL rc=$RC — job eliminado (no reboot en loop)" >> "$LOG"
  rm -f "$FOUND/norjob.bin" "$FOUND/norjob.sha256"
  cp "$LOG" "$FOUND/norflash.log" 2>/dev/null
  sync
fi
exit 0
