#!/bin/sh
# S09trace v5 (iteracion 7a) — diagnostico OPT-IN.
# v4 (9d): escribia boottrace/virtuart/treefrog_ui a la SD en CADA boot
#          (copies+sync cada 2s, ~60s tras picoarch) = desgaste SD + I/O.
# v5: solo escribe a la SD si existe el flag /media/*/cubegm/diag.enabled.
#     Sin flag: buffers SOLO en /tmp (RAM) para inspeccion via shell vivo;
#     cero escrituras a SD; se auto-apaga tras el probe post-picoarch.
#     Para debuggear: crear G:\cubegm\diag.enabled (archivo vacio) y reboot.
LOG=/tmp/boottrace.log
V=/tmp/virtuart.log
IRQ=/tmp/irq66.log
: > "$LOG"; : > "$V"; : > "$IRQ"
echo "T0 uptime=$(cut -d' ' -f1 /proc/uptime) kernel=$(uname -r)" >> "$LOG"

# lector persistente del virtuart (bg; muere al final del script)
( while true; do cat /dev/virtuart >> "$V" 2>/dev/null; usleep 300000; done ) &
VREADER=$!

# probe no-bloqueante: writes en bg + kill
avp_write() {
  printf "$1" > /dev/virtuart 2>/dev/null &
  WP=$!
  sleep 1
  kill $WP 2>/dev/null
}

# 7a: copiar a SD solo con flag opt-in
sd_copy() {
  for d in /media/*/cubegm; do
    [ -d "$d" ] && { cp "$LOG" "$d/boottrace.log" 2>/dev/null; cp "$V" "$d/virtuart_boot.log" 2>/dev/null; cp /tmp/treefrog_ui.log "$d/treefrog_ui.log" 2>/dev/null; sync; }
  done
}

# 7a: flag opt-in — se evalua cuando la SD ya esta montada
diag_on() {
  for d in /media/*/cubegm; do
    [ -f "$d/diag.enabled" ] && return 0
  done
  return 1
}

(
  N=0
  while [ $N -lt 150 ]; do
    {
      echo "=== uptime=$(cut -d' ' -f1 /proc/uptime) ==="
      ps w 2>/dev/null
      grep -E "sdcard|/media| /lib | /bin | /sbin | /usr | /etc |swap" /proc/mounts 2>/dev/null
      grep -E "^ *66:" /proc/interrupts 2>/dev/null
    } >> "$LOG"
    # 7a: solo copiar a SD con flag
    diag_on && sd_copy
    # probe del shell NSH: no bloqueante, una vez picoarch vive
    if pidof picoarch >/dev/null 2>&1; then
      echo "=== picoarch ON: probing AVP (bg+kill) ===" >> "$LOG"
      avp_write "\r\n"
      avp_write "help\r\n"
      avp_write "ps\r\n"
      sleep 3
      echo "=== virtuart capturado hasta ahora ===" >> "$LOG"
      cat "$V" >> "$LOG"
      echo "=== dmesg tail ===" >> "$LOG"
      dmesg 2>/dev/null >> "$LOG"
      diag_on && sd_copy
      if diag_on; then
        echo "=== probe ronda 1 lista — seguimos monitoreando 60s ===" >> "$LOG"
        M=0
        while [ $M -lt 30 ]; do
          grep -E "^ *66:" /proc/interrupts 2>/dev/null >> "$LOG"
          sd_copy
          M=$((M+1))
          sleep 2
        done
        echo "=== FIN MONITOREO 60s ===" >> "$LOG"
        echo "=== DMESG FINAL (post-juego) ===" >> "$LOG"
        dmesg 2>/dev/null >> "$LOG"
        echo "=== VIRTUART FINAL ===" >> "$LOG"
        cat "$V" >> "$LOG"
        sd_copy
      else
        echo "=== diag.enabled AUSENTE (7a opt-in): monitoreo 60s OFF — dump queda solo en /tmp ===" >> "$LOG"
      fi
      kill $VREADER 2>/dev/null
      exit 0
    fi
    N=$((N+1))
    sleep 2
  done
  kill $VREADER 2>/dev/null
) &
